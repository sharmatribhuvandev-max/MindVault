PORT=3000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/mindvault
JWT_SECRET=replace_with_a_random_secret
FRONTEND_URL=http://localhost:5173
# Reverse-proxy hops in front of the API (defaults: 1 in production, 0 otherwise)
# TRUST_PROXY=1

# "Continue with Google / GitHub" (optional). Each provider is enabled only
# when both its client ID and secret are set. See docs/DEPLOYMENT.md.
# Public URL of this API, used to build the OAuth callback URLs.
API_PUBLIC_URL=http://localhost:3000
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
